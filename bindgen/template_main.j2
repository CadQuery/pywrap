// pybind 11 related includes
#include <pybind11/pybind11.h>
#include <pybind11/stl.h>

namespace py = pybind11;

// user-defined pre
{% if include_pre %}
#include "{{ include_pre }}"
{% endif %}

// forward declaration of the register_* functions

{% for mod in module_names %}
void register_{{mod}}_enums(py::module&);
{% endfor %}

{% for mod in module_names %}
void register_{{mod}}(py::module&);
{% endfor %}

// forward declaration of collection registration functions
{% for i_coll in range(N_coll_chunks) %}
void register_collections_pre_{{i_coll}}(py::module&);
void register_collections_{{i_coll}}(py::module&);
{% endfor %}

// collection chunks wrapped so that every table row takes the main module
static void register_collections_enums(py::module &main_module) {
    py::module m_coll = main_module.def_submodule("collections", R"#(Artifical module with instantiated collection types)#");
{% for i_coll in range(N_coll_chunks) %}
    register_collections_pre_{{i_coll}}(m_coll);
{% endfor %}
}

static void register_collections(py::module &main_module) {
    py::module m_coll = static_cast<py::module>(main_module.attr("collections"));
{% for i_coll in range(N_coll_chunks) %}
    register_collections_{{i_coll}}(m_coll);
{% endfor %}
}

{% if settings['lazy'] %}
static const lazy::desc {{name}}_modules[] = {
{% for mod in sorted_modules %}
    {"{{mod}}", &register_{{mod}}_enums, &register_{{mod}}, "{{ module_deps[mod]|sort|join(',') }}"},
{% endfor %}
    {"collections", &register_collections_enums, &register_collections, "{{ collections_deps|sort|join(',') }}"},
};
{% endif %}

// main module definiiton
PYBIND11_MODULE({{name}}, m) {

{% if settings['lazy'] %}
// phase 1 of every package
    for (const auto &d : {{name}}_modules) d.enums(m);
{% else %}
// register submodules
{% for mod in sorted_modules %}
    register_{{mod}}_enums(m);
{% endfor %}
// preregister collections
    register_collections_enums(m);
// register modules
{% for mod in sorted_modules %}
    register_{{mod}}(m);
{% endfor %}
{% endif %}

// Add attributes if present

{% for k,v in settings['Attributes'].items() %}
    m.attr("{{k}}") = py::cast("{{v}}");
{% endfor %}

{% if settings['lazy'] %}
// phase 2: per package on first use
    lazy::install(m, {{name}}_modules);
{% else %}
// register collection types
    register_collections(m);
{% endif %}

}
